---
import Picture from './Picture.astro'
import Icon from './Icon.astro'
import { release, heroScreenshots } from '../data/site.js'
---

<section class="hero">
  <div class="hero-panel">
    <div class="hero-art" data-hero-shots>
      {heroScreenshots.map((base, i) =>
        i === 0 ? (
          <div class="hero-shot" data-active="true">
            <Picture
              base={base}
              alt="The Pelton window: three accounts in the sidebar, a message list with colored flags, and an open message in the reading pane"
              width={1400}
              height={936}
              loading="eager"
              fetchpriority="high"
              sizes="(max-width: 900px) 100vw, 1000px"
            />
          </div>
        ) : (
          <div class="hero-shot" data-active="false" data-base={base} data-w="1400" data-h="936" />
        )
      )}
    </div>

    <div class="hero-copy">
      <h1 class="lines">
        <span><span>Free and</span></span>
        <span><span>open-source</span></span>
        <span><span>desktop email.</span></span>
      </h1>
    </div>

    <a class="hero-dock" href="/download">
      <Icon name="download" size={22} stroke={2} />
      <span class="hero-dock-text">
        <span>Download</span>
        <small>Version {release.version}</small>
      </span>
    </a>
  </div>
</section>

<script>
  import { initShotCarousel } from '../scripts/shots.js'
  initShotCarousel('[data-hero-shots]', '.hero-shot', { intervalMs: 2000 })
</script>
