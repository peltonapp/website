---
interface Props {
  base: string
  alt: string
  width: number
  height: number
  sizes?: string
  /** Extra narrower variants available as `${base}-${w}w.{avif,webp}`, so the
   * browser is not stuck downloading the full-resolution image at every
   * viewport size. `width` above is always included as the widest entry. */
  widths?: number[]
  loading?: 'lazy' | 'eager'
  fetchpriority?: 'high' | 'low' | 'auto'
  decoding?: 'async' | 'sync' | 'auto'
  class?: string
}

const {
  base,
  alt,
  width,
  height,
  sizes,
  widths = [],
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  class: cls = '',
} = Astro.props

const allWidths = [...widths, width].sort((a, b) => a - b)
const srcset = (ext: string) => allWidths.map((w) => `${base}${w === width ? '' : `-${w}w`}.${ext} ${w}w`).join(', ')
---

<picture>
  <source srcset={srcset('avif')} type="image/avif" sizes={sizes} />
  <source srcset={srcset('webp')} type="image/webp" sizes={sizes} />
  <img
    src={`${base}.png`}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={cls}
  />
</picture>
