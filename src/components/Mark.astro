---
interface Props {
  size?: number
  class?: string
}

const { size = 26, class: cls = '' } = Astro.props

const now = new Date()
const aprilFools = now.getMonth() === 3 && now.getDate() === 1
const base = aprilFools ? '/img/pelton-themes-mark' : '/img/pelton-mark'
---

<picture class={cls}>
  <source srcset={`${base}.avif`} type="image/avif" />
  <source srcset={`${base}.webp`} type="image/webp" />
  <img src={`${base}.png`} alt="" width={size} height={size} />
</picture>
