---
import Icon from './Icon.astro'
import Mark from './Mark.astro'
import { links, release } from '../data/site.js'

const year = 2026

// Fetched once per build, not per visitor: this runs at build time, gets
// baked into the static HTML, and costs nothing at request time. A failed
// or rate-limited request just means the page ships without the count
// rather than failing the build.
let stars: number | null = null
try {
  const res = await fetch(links.repoApi, {
    headers: { 'User-Agent': 'pelton-website-build', Accept: 'application/vnd.github+json' },
  })
  if (res.ok) {
    const data = await res.json()
    if (typeof data.stargazers_count === 'number') stars = data.stargazers_count
  }
} catch {
  stars = null
}

const starLabel = stars !== null ? new Intl.NumberFormat('en', { notation: 'compact' }).format(stars) : null
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="/">
          <Mark size={26} />
          <span>Pelton</span>
          <span class="ipa" aria-hidden="true">/&#712;p&#603;ltn&#809;/</span>
          <span class="sr-only">, pronounced pelton</span>
        </a>
        <p>
          A free, open-source desktop email client. Your mail stays on your computer and with
          your own provider.
        </p>
        <div class="foot-social">
          <a href={links.org} rel="noreferrer noopener" aria-label="Pelton on GitHub">
            <Icon name="brand-github" size={19} />
          </a>
          <a href={links.discord} aria-label="Pelton on Discord">
            <Icon name="brand-discord" size={19} />
          </a>
          <a href={`mailto:${links.email}`} aria-label="Email Pelton">
            <Icon name="mail" size={19} />
          </a>
        </div>
      </div>

      <div>
        <h3>Pelton Client</h3>
        <ul>
          <li><a href="/download">Download</a></li>
          <li><a href="/#features">Features</a></li>
          <li><a href="/privacy-security">Privacy and security</a></li>
          <li><a href="/changelog">Changelog</a></li>
          <li><a href={links.client} rel="noreferrer noopener">Source code</a></li>
          <li><a href={links.issues} rel="noreferrer noopener">Issue tracker</a></li>
          <li><a href={links.themesSite} rel="noreferrer noopener">Theme gallery</a></li>
          <li><a href="/design">Design system</a></li>
        </ul>
      </div>

      <div>
        <h3>Project</h3>
        <ul>
          <li><a href={links.org} rel="noreferrer noopener">GitHub organisation</a></li>
          <li><a href="/community">Contribute</a></li>
          <li><a href={links.docs} rel="noreferrer noopener">Documentation</a></li>
        </ul>
      </div>

      <div>
        <h3>Legal</h3>
        <ul>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/terms">Terms and liability</a></li>
          <li><a href="/imprint">Imprint</a></li>
          <li><a href={links.license} rel="noreferrer noopener">GPL-3.0 licence</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-note">
      <span>&copy; {year} The Pelton Project. Released under the GNU GPL-3.0.</span>
      <nav aria-label="Meta">
        <a href="/changelog">v{release.version}</a>
        {starLabel && (
          <a class="foot-stars" href={`${links.client}/stargazers`} rel="noreferrer noopener">
            <Icon name="star" size={13} stroke={2} />
            {starLabel}
          </a>
        )}
        <a href="/llms.txt">llms.txt</a>
        <a href="/.well-known/security.txt">security.txt</a>
      </nav>
    </div>
  </div>
</footer>
