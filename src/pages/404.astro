---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found — Pelton" description="That page does not exist on pelton.app." noindex>
  <section class="band">
    <div class="wrap center-page">
      <p class="code404 mono">404</p>
      <h1 class="h-section">No such page.</h1>
      <p class="lead">The link may be old, or the page moved.</p>
      <div class="btn-row">
        <a class="btn accent" href="/">Home</a>
        <a class="btn" href="/download">Download</a>
      </div>
    </div>
  </section>
</Base>
