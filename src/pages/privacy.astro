<Base
  title="Privacy Policy — Pelton"
  description="Privacy policy for the pelton.app website, covering hosting, analytics, third-country transfers and your rights."
  noindex
>
  <section class="band band-tight legal-body" data-tint="base">
    <div class="wrap wrap-narrow">
      <h1>Privacy Policy</h1>
      <p class="legal-meta">Last updated: 22 September 2026</p>
        <nav class="legal-switch" aria-label="Language">
          <a href="/privacy" class="is-active">English</a>
